#!/usr/bin/env node
'use strict';

/**
 * Implementation behind `/optimus-stats`.
 *
 * Reads Claude Code's own transcript files directly — there is no
 * documented API for this, it's the same mechanism `caveman-stats.js`
 * uses for its own (single-transcript) reporting. Two things this
 * script does that a naive version would get wrong (see how_it_works.md):
 *
 *  1. Subagent usage lives in SEPARATE transcript files
 *     (`<session-dir>/subagents/agent-<id>.jsonl`), not in the parent
 *     session's own transcript. They must be walked explicitly.
 *  2. The convenient rollup Claude Code attaches to the parent's Agent
 *     tool-result (`toolUseResult.usage`) is NOT a reliable total — it
 *     is only the subagent's LAST assistant turn, so it silently
 *     under-counts any subagent that used more than one turn (i.e. used
 *     any tool at all, which is the normal case). This script sums every
 *     `type:"assistant"` line in the actual subagent transcript instead.
 *
 * Degrades to a plain "no data yet" message rather than throwing when
 * there's nothing to report — this must be safe to run in a brand new
 * project with zero history.
 */

const fs = require('fs');
const path = require('path');
const os = require('os');
const { findProjectRoot, CONFIG_DIRNAME } = require(
  path.join(__dirname, '..', 'hooks', 'optimus-config.js')
);
const { STATE_DIRNAME, LEDGER_FILENAME } = require(
  path.join(__dirname, '..', 'hooks', 'optimus-ledger.js')
);

// Pricing snapshot used during Optimus's research (see limitations.md "Known
// limitations" for sourcing). ESTIMATES — verify current numbers at
// https://anthropic.com/pricing before trusting these for anything real.
const PRICING_SNAPSHOT_DATE = '2026-06-24';
const PRICING = {
  'claude-opus-5': { input: 5.0, output: 25.0 },
  'claude-sonnet-5': { input: 2.0, output: 10.0 },
  'claude-haiku-4-5': { input: 1.0, output: 5.0 },
};

// Cache-token multipliers relative to the model's own base input price.
// NOT independently re-verified in this plugin's research — stated
// explicitly as an assumption in the printed output, not silently baked in.
const CACHE_WRITE_MULT = 1.25; // ~5-minute TTL cache write
const CACHE_READ_MULT = 0.1;

/** Tool names that mean "dispatch a subagent", across both hosts. */
const DISPATCH_TOOLS = new Set(['Task', 'Agent']);

function pricingFor(model) {
  if (!model) return null;
  const key = Object.keys(PRICING).find((k) => model.indexOf(k) === 0 || model.indexOf(k) !== -1);
  return key ? PRICING[key] : null;
}

function emptyUsage() {
  return { input_tokens: 0, output_tokens: 0, cache_creation_input_tokens: 0, cache_read_input_tokens: 0, turns: 0 };
}

function addUsage(target, usage) {
  if (!usage) return;
  target.input_tokens += usage.input_tokens || 0;
  target.output_tokens += usage.output_tokens || 0;
  target.cache_creation_input_tokens += usage.cache_creation_input_tokens || 0;
  target.cache_read_input_tokens += usage.cache_read_input_tokens || 0;
  target.turns += 1;
}

function costFor(model, u) {
  const p = pricingFor(model);
  if (!p) return null;
  return (
    (u.input_tokens / 1e6) * p.input +
    (u.output_tokens / 1e6) * p.output +
    (u.cache_creation_input_tokens / 1e6) * p.input * CACHE_WRITE_MULT +
    (u.cache_read_input_tokens / 1e6) * p.input * CACHE_READ_MULT
  );
}

// Empirically observed slug format: cwd with EVERY non-alphanumeric
// character replaced by a dash (e.g. /Users/x.y@z/a_b -> -Users-x-y-z-a-b).
// Case is preserved. Undocumented, Claude-Code-internal, not a stable
// public API — if a future version changes this layout, this lookup needs
// updating (see limitations.md). NOT verified: whether Claude Code collapses a run
// of consecutive non-alphanumeric characters into a single dash, or emits
// one dash per character as this does — no observed real project path has
// had two separator characters in a row. Because this is a guess at an
// undocumented format, `resolveProjectDir` below treats it as a fast path
// only and falls back to reading transcripts directly when it misses.
function slugForCwd(cwd) {
  return cwd.replace(/[^a-zA-Z0-9]/g, '-');
}

// Strips trailing slashes (but never collapses "/" itself) so a cwd with
// or without a trailing separator compares equal.
function normalizeCwd(cwd) {
  if (typeof cwd !== 'string') return cwd;
  return cwd.length > 1 ? cwd.replace(/\/+$/, '') : cwd;
}

// Reads at most `maxBytes` from the start of `filePath` and returns up to
// `maxLines` complete lines from it. Deliberately does NOT read the whole
// file — Claude Code transcripts can be large, and this is only ever used
// to peek at a transcript's leading metadata (its `cwd` field), not to
// account usage. Any I/O failure (missing file, permissions, etc.) is
// swallowed and yields an empty array rather than throwing.
function readFirstLines(filePath, maxLines, maxBytes) {
  let fd;
  try {
    fd = fs.openSync(filePath, 'r');
  } catch (e) {
    return [];
  }
  try {
    const buf = Buffer.alloc(maxBytes);
    let bytesRead = 0;
    try {
      bytesRead = fs.readSync(fd, buf, 0, maxBytes, 0);
    } catch (e) {
      return [];
    }
    const text = buf.toString('utf8', 0, bytesRead);
    const lines = text.split('\n');
    // The buffer may have been filled mid-line; drop the last (possibly
    // truncated) line in that case so we never try to parse a partial one.
    if (bytesRead === maxBytes) lines.pop();
    return lines.slice(0, maxLines);
  } catch (e) {
    return [];
  } finally {
    try {
      fs.closeSync(fd);
    } catch (e) {
      // ignore
    }
  }
}

// Resolves the on-disk transcript directory for `cwd` under `projectsRoot`.
//
// This talks to two layers, in order, because the slug format above is a
// reverse-engineered guess at an undocumented layout:
//
//  1. Fast path: assume the guessed slug is right and check whether that
//     directory exists.
//  2. Fallback: every Claude Code transcript line carries a top-level
//     `cwd` field with the real project path. If the fast path misses
//     (wrong guess, or a future layout change), scan each subdirectory of
//     projectsRoot, peek at the first few lines of its first `.jsonl`
//     file, and match on that field directly instead of on the directory
//     name at all.
//
// Returns null if nothing matches. Every fs/JSON operation here is
// wrapped so an unreadable directory, an empty directory, a missing
// `.jsonl` file, or a malformed JSON line is skipped rather than thrown.
function resolveProjectDir(cwd, projectsRoot) {
  const target = normalizeCwd(cwd);

  const fastPath = path.join(projectsRoot, slugForCwd(target));
  try {
    if (fs.existsSync(fastPath) && fs.statSync(fastPath).isDirectory()) return fastPath;
  } catch (e) {
    // fall through to the transcript-scanning fallback
  }

  let entries = [];
  try {
    entries = fs.readdirSync(projectsRoot, { withFileTypes: true });
  } catch (e) {
    return null; // projectsRoot itself doesn't exist/isn't readable yet
  }

  const subdirs = entries
    .filter((e) => {
      try {
        return e.isDirectory();
      } catch (err) {
        return false;
      }
    })
    .map((e) => e.name)
    .sort();

  for (const name of subdirs) {
    const dirPath = path.join(projectsRoot, name);
    let files = [];
    try {
      files = fs
        .readdirSync(dirPath, { withFileTypes: true })
        .filter((e) => {
          try {
            return e.isFile() && e.name.endsWith('.jsonl');
          } catch (err) {
            return false;
          }
        })
        .map((e) => e.name)
        .sort();
    } catch (e) {
      continue; // unreadable directory — skip it
    }
    if (files.length === 0) continue;

    const firstTranscript = path.join(dirPath, files[0]);
    const lines = readFirstLines(firstTranscript, 5, 8192);
    for (const line of lines) {
      const t = line.trim();
      if (!t) continue;
      let rec;
      try {
        rec = JSON.parse(t);
      } catch (e) {
        continue; // malformed/half-written line — skip it, don't throw
      }
      if (rec && typeof rec.cwd === 'string' && rec.cwd === target) return dirPath;
    }
  }

  return null;
}

function readAssistantUsage(filePath, byModel) {
  let raw;
  try {
    raw = fs.readFileSync(filePath, 'utf8');
  } catch (e) {
    return;
  }
  for (const line of raw.split('\n')) {
    const t = line.trim();
    if (!t) continue;
    let rec;
    try {
      rec = JSON.parse(t);
    } catch (e) {
      continue; // skip malformed/half-written lines rather than aborting
    }
    if (rec.type !== 'assistant') continue;
    const msg = rec.message;
    if (!msg || !msg.model) continue;
    if (!byModel[msg.model]) byModel[msg.model] = emptyUsage();
    addUsage(byModel[msg.model], msg.usage);
  }
}

function readLines(filePath) {
  try {
    return fs.readFileSync(filePath, 'utf8').split('\n');
  } catch (e) {
    return [];
  }
}

function parseRec(line) {
  const t = (line || '').trim();
  if (!t) return null;
  try {
    return JSON.parse(t);
  } catch (e) {
    return null;
  }
}

/**
 * Finds the dispatch cycles in an orchestrator transcript: each Task/Agent
 * tool_use block, paired with the tool_result that closes it.
 *
 * The pairing is by tool_use_id, which is the only stable link between the
 * two records. Block structure inside message.content is an undocumented
 * Claude Code implementation detail — an unrecognizable transcript yields
 * an empty list, which costs the report a coordinator figure but never
 * crashes it.
 */
function parseOrchestratorDispatches(filePath) {
  const lines = readLines(filePath);
  const cycles = [];
  const open = new Map();

  lines.forEach((line, index) => {
    const rec = parseRec(line);
    const msg = rec && rec.message;
    if (!msg || !Array.isArray(msg.content)) return;

    for (const block of msg.content) {
      if (!block || typeof block !== 'object') continue;

      if (rec.type === 'assistant' && block.type === 'tool_use' && DISPATCH_TOOLS.has(block.name)) {
        const cycle = {
          toolUseId: block.id || null,
          dispatchModel: msg.model || null,
          subagentModel: (block.input && block.input.model) || null,
          startIndex: index,
          endIndex: -1,
        };
        cycles.push(cycle);
        if (cycle.toolUseId) open.set(cycle.toolUseId, cycle);
      }

      if (block.type === 'tool_result' && open.has(block.tool_use_id)) {
        open.get(block.tool_use_id).endIndex = index;
        open.delete(block.tool_use_id);
      }
    }
  });

  return cycles;
}

function firstModelIn(filePath) {
  let raw;
  try {
    raw = fs.readFileSync(filePath, 'utf8');
  } catch (e) {
    return null;
  }
  for (const line of raw.split('\n')) {
    const t = line.trim();
    if (!t) continue;
    let rec;
    try {
      rec = JSON.parse(t);
    } catch (e) {
      continue;
    }
    if (rec.type === 'assistant' && rec.message && rec.message.model) return rec.message.model;
  }
  return null;
}

function printUsageTable(title, byModel) {
  console.log(title);
  const models = Object.keys(byModel);
  if (models.length === 0) {
    console.log('  (none)');
    return 0;
  }
  let totalCost = 0;
  for (const model of models) {
    const u = byModel[model];
    const cost = costFor(model, u);
    if (cost !== null) totalCost += cost;
    console.log(
      '  ' +
        model +
        ': turns=' +
        u.turns +
        ' input=' +
        u.input_tokens +
        ' output=' +
        u.output_tokens +
        ' cache_write=' +
        u.cache_creation_input_tokens +
        ' cache_read=' +
        u.cache_read_input_tokens +
        (cost !== null ? ' cost=$' + cost.toFixed(4) : ' cost=unknown (no pricing entry for this model id)')
    );
  }
  console.log('  subtotal cost: $' + totalCost.toFixed(4));
  return totalCost;
}

// ---------------------------------------------------------------------------
// Enforcement ledger reporting.
//
// Reads the append-only ledger hooks/optimus-ledger.js writes under
// `<project root>/.optimus/state/` and reports what Optimus's gate actually
// did — dispatch allow/deny counts, work-tool denials, Bash nudges — plus
// an approximate comparison between the model ALIAS a dispatch requested
// (what the ledger records) and the ACTUAL resolved model id a subagent
// transcript shows it ran on (what `dispatchesByModel` above already
// computes from `firstModelIn`).
//
// Entirely independent of, and additive to, everything above: every
// function here guards its own fs/JSON calls, so a missing, partial, or
// corrupt ledger can never crash this script or change any line already
// printed above it. If no ledger exists at all — a project that predates
// this feature, or one where Optimus has never recorded an enforcement
// event — readLedgerEvents() returns null and main() omits this entire
// section, leaving prior output byte-identical to before this feature
// existed.

/**
 * Reduces a resolved-or-requested model string down to a coarse family
 * bucket by substring match only: 'haiku' | 'sonnet' | 'opus' | 'other'.
 * Deliberately NOT a table of exact alias -> model-id mappings — aliases
 * move when models version (the same reason PRICING_SNAPSHOT_DATE above is
 * dated rather than trusted forever), so a hardcoded mapping would go
 * stale silently. Family-level comparison is the most that can be
 * asserted without re-deriving that mapping on every release.
 */
function modelFamily(modelStr) {
  if (typeof modelStr !== 'string') return 'other';
  const s = modelStr.toLowerCase();
  if (s.indexOf('haiku') !== -1) return 'haiku';
  if (s.indexOf('sonnet') !== -1) return 'sonnet';
  if (s.indexOf('opus') !== -1) return 'opus';
  return 'other';
}

/** Collapses a per-exact-model-id count map (e.g. dispatchesByModel) into per-family counts. */
function familyCountsFromModelTally(byModelCount) {
  const fam = {};
  for (const model of Object.keys(byModelCount || {})) {
    fam[modelFamily(model)] = (fam[modelFamily(model)] || 0) + byModelCount[model];
  }
  return fam;
}

/**
 * Appends every well-formed ledger record found in `filePath` onto `sink`.
 * Silently skips a missing/unreadable file and any line that isn't valid
 * JSON with a string `ev` field — same "never throw, skip malformed lines"
 * convention as readAssistantUsage()/firstModelIn() above. Never throws.
 */
function readLedgerLines(filePath, sink) {
  let raw;
  try {
    raw = fs.readFileSync(filePath, 'utf8');
  } catch (e) {
    return;
  }
  for (const line of raw.split('\n')) {
    const t = line.trim();
    if (!t) continue;
    let rec;
    try {
      rec = JSON.parse(t);
    } catch (e) {
      continue; // malformed/half-written line -- skip it, don't throw
    }
    if (rec && typeof rec === 'object' && typeof rec.ev === 'string') sink.push(rec);
  }
}

/**
 * Loads every event from the current project's ledger — `events.jsonl`
 * plus a rotated `events.jsonl.1` generation if present (older generation
 * read first, for a roughly chronological order; callers only ever
 * aggregate counts, so order otherwise doesn't matter).
 *
 * `root` is resolved via findProjectRoot() (from optimus-config.js) on the
 * same `cwd` this script already uses everywhere else — the repo-local
 * walk-up that hooks/optimus-gate.js and hooks/optimus-ledger.js use to
 * find `.optimus/config.json`, which is a completely different resolution
 * mechanism than resolveProjectDir() above (that one locates Claude Code's
 * own transcript directory under `~/.claude/projects/<slug>`). The two are
 * independent on purpose: the ledger lives inside the project's own repo,
 * not under Claude Code's config directory.
 *
 * Returns null if neither ledger file exists — the caller's signal to
 * omit the whole enforcement section for back-compat with projects that
 * predate this feature (or simply haven't recorded an event yet). Returns
 * `{ events, rotated }` otherwise, where `rotated` is true iff the rotated
 * generation was found (feeds the approximate-comparison caveat below).
 */
function readLedgerEvents(root) {
  if (!root) return null;
  try {
    const dir = path.join(root, CONFIG_DIRNAME, STATE_DIRNAME);
    const mainFile = path.join(dir, LEDGER_FILENAME);
    const rotatedFile = mainFile + '.1';

    let mainExists = false;
    let rotatedExists = false;
    try {
      mainExists = fs.statSync(mainFile).isFile();
    } catch (e) {
      mainExists = false;
    }
    try {
      rotatedExists = fs.statSync(rotatedFile).isFile();
    } catch (e) {
      rotatedExists = false;
    }

    if (!mainExists && !rotatedExists) return null;

    const events = [];
    if (rotatedExists) readLedgerLines(rotatedFile, events);
    if (mainExists) readLedgerLines(mainFile, events);
    return { events: events, rotated: rotatedExists };
  } catch (e) {
    return null;
  }
}

/** Tallies raw ledger events into the counts the enforcement section reports. */
function tallyLedgerEvents(events) {
  const tally = {
    dispatchAllowed: 0,
    deniedByReason: {},
    workToolDeniedByTool: {},
    inlineAllowedByTool: {},
    bashNudgeByCmdHead: {},
    requestedFamily: {},
  };
  for (const rec of events) {
    switch (rec.ev) {
      case 'dispatch_allowed': {
        tally.dispatchAllowed += 1;
        const fam = modelFamily(rec.model);
        tally.requestedFamily[fam] = (tally.requestedFamily[fam] || 0) + 1;
        break;
      }
      case 'dispatch_denied': {
        const reason = typeof rec.reason === 'string' ? rec.reason : 'unknown';
        tally.deniedByReason[reason] = (tally.deniedByReason[reason] || 0) + 1;
        break;
      }
      case 'work_tool_denied': {
        const tool = typeof rec.tool === 'string' ? rec.tool : 'unknown';
        tally.workToolDeniedByTool[tool] = (tally.workToolDeniedByTool[tool] || 0) + 1;
        break;
      }
      case 'work_tool_inline_allowed': {
        const tool = typeof rec.tool === 'string' ? rec.tool : 'unknown';
        tally.inlineAllowedByTool[tool] = (tally.inlineAllowedByTool[tool] || 0) + 1;
        break;
      }
      case 'bash_nudge': {
        const head = typeof rec.cmd_head === 'string' ? rec.cmd_head : 'unknown';
        tally.bashNudgeByCmdHead[head] = (tally.bashNudgeByCmdHead[head] || 0) + 1;
        break;
      }
      default:
        break; // unknown/future event type -- ignore rather than miscount or crash
    }
  }
  return tally;
}

/**
 * Prints the "Enforcement ledger summary" and "Requested-vs-actual model
 * family" blocks. See the comment above readLedgerEvents() for why the
 * two sides of that comparison can legitimately disagree without any real
 * drift having occurred (rotation losing history, transcripts pruned
 * independently, only *allowed* dispatches ever reaching a transcript) —
 * this function hedges accordingly rather than asserting drift as fact.
 */
function printLedgerSection(ledger, dispatchesByModel) {
  const tally = tallyLedgerEvents(ledger.events);

  console.log('Enforcement ledger summary (from .optimus/state/events.jsonl):');
  console.log('  dispatches allowed         : ' + tally.dispatchAllowed);
  console.log(
    '  dispatches denied by reason: ' +
      (Object.keys(tally.deniedByReason).length ? JSON.stringify(tally.deniedByReason) : '(none)')
  );
  console.log(
    '  work-tool denials by tool  : ' +
      (Object.keys(tally.workToolDeniedByTool).length
        ? JSON.stringify(tally.workToolDeniedByTool)
        : '(none)')
  );
  console.log(
    '  work-tool inline allowed   : ' +
      (Object.keys(tally.inlineAllowedByTool).length
        ? JSON.stringify(tally.inlineAllowedByTool)
        : '(none)')
  );
  console.log(
    '  bash nudges by cmd_head    : ' +
      (Object.keys(tally.bashNudgeByCmdHead).length
        ? JSON.stringify(tally.bashNudgeByCmdHead)
        : '(none)')
  );
  console.log('');

  const requestedFamily = tally.requestedFamily;
  const actualFamily = familyCountsFromModelTally(dispatchesByModel);
  const families = ['haiku', 'sonnet', 'opus', 'other'];

  console.log(
    'Requested-vs-actual model family (ledger-requested alias vs. transcript-resolved model, family-level only):'
  );
  let anyFamilyDiffers = false;
  let requestedTotal = 0;
  let actualTotal = 0;
  for (const fam of families) {
    const requested = requestedFamily[fam] || 0;
    const actual = actualFamily[fam] || 0;
    requestedTotal += requested;
    actualTotal += actual;
    const differs = requested !== actual;
    if (differs) anyFamilyDiffers = true;
    console.log(
      '  ' +
        fam.padEnd(6) +
        ': requested=' +
        requested +
        ' actual=' +
        actual +
        (differs ? '  <- counts differ' : '')
    );
  }
  console.log('');

  if (anyFamilyDiffers) {
    console.log(
      'Model family check: requested and actual counts differ for at least one family -- counts ' +
        'differ, which may be rotation/pruning rather than drift (see caveat below), not proof that a ' +
        'different model actually ran than what was requested.'
    );
  } else {
    console.log('Model family check: requested and actual counts match for every family -- no drift indicated.');
  }

  const totalsDiffer = requestedTotal !== actualTotal;
  if (ledger.rotated || totalsDiffer) {
    console.log('');
    console.log(
      'CAVEAT: this requested-vs-actual comparison is approximate, not proof of drift either way. The ' +
        'ledger is cumulative and loses history when it rotates; transcripts can be pruned independently ' +
        "of the ledger; and only *allowed* dispatches ever reach a transcript (a denied dispatch never " +
        'ran, so it can never appear on the actual side).'
    );
    if (ledger.rotated) {
      console.log('  A rotated events.jsonl.1 generation was included in these counts.');
    }
    if (totalsDiffer) {
      console.log(
        '  Requested and actual totals differ overall (' +
          requestedTotal +
          ' vs ' +
          actualTotal +
          ') -- counts differ, may be rotation/pruning rather than drift.'
      );
    }
  }
}

function main() {
  const cwd = process.env.CLAUDE_PROJECT_DIR || process.cwd();
  const claudeConfigDir = process.env.CLAUDE_CONFIG_DIR || path.join(os.homedir(), '.claude');
  const projectsRoot = path.join(claudeConfigDir, 'projects');
  const projectDir = resolveProjectDir(cwd, projectsRoot);

  console.log('Optimus stats for ' + cwd);
  console.log('');

  if (!projectDir) {
    console.log('No Optimus usage data yet for this project.');
    console.log(
      '(Looked for a directory under ' +
        projectsRoot +
        " matching Claude Code's undocumented project-slug layout [every " +
        'non-alphanumeric character in the cwd -> dash], and — as a fallback — for any project ' +
        "directory whose transcript's own recorded `cwd` field matches this project exactly. " +
        'Neither found anything. If a future Claude Code version changes this layout, this ' +
        'lookup will need updating.)'
    );
    process.exit(0);
  }

  let entries = [];
  try {
    entries = fs.readdirSync(projectDir, { withFileTypes: true });
  } catch (e) {
    entries = [];
  }
  const sessionFiles = entries.filter((e) => e.isFile() && e.name.endsWith('.jsonl')).map((e) => e.name);

  if (sessionFiles.length === 0) {
    console.log('No session transcripts found yet for this project.');
    process.exit(0);
  }

  const orchestratorUsage = {};
  const delegatedUsage = {};
  const dispatchesByType = {};
  const dispatchesByModel = {};
  let dispatchCount = 0;

  for (const name of sessionFiles) {
    const sessionId = name.replace(/\.jsonl$/, '');
    readAssistantUsage(path.join(projectDir, name), orchestratorUsage);

    const subagentsDir = path.join(projectDir, sessionId, 'subagents');
    let subFiles = [];
    try {
      subFiles = fs.readdirSync(subagentsDir).filter((f) => f.endsWith('.jsonl'));
    } catch (e) {
      subFiles = [];
    }

    for (const subFile of subFiles) {
      const subPath = path.join(subagentsDir, subFile);
      readAssistantUsage(subPath, delegatedUsage);
      dispatchCount += 1;

      const metaPath = subPath.replace(/\.jsonl$/, '.meta.json');
      let agentType = 'unknown';
      try {
        const meta = JSON.parse(fs.readFileSync(metaPath, 'utf8'));
        if (meta && meta.agentType) agentType = meta.agentType;
      } catch (e) {
        // meta missing or unreadable — still count the dispatch, just as "unknown" type
      }
      dispatchesByType[agentType] = (dispatchesByType[agentType] || 0) + 1;

      const subModel = firstModelIn(subPath);
      if (subModel) dispatchesByModel[subModel] = (dispatchesByModel[subModel] || 0) + 1;
    }
  }

  const totalTurns =
    Object.values(orchestratorUsage).reduce((a, u) => a + u.turns, 0) +
    Object.values(delegatedUsage).reduce((a, u) => a + u.turns, 0);
  if (totalTurns === 0) {
    console.log('No Optimus usage data yet for this project (session files exist but contain no assistant turns).');
    process.exit(0);
  }

  console.log('Project transcript dir: ' + projectDir);
  console.log('');
  console.log('Pricing assumed (USD per million tokens; snapshot dated ' + PRICING_SNAPSHOT_DATE + ' — verify at https://anthropic.com/pricing):');
  for (const [m, p] of Object.entries(PRICING)) {
    console.log('  ' + m + ': $' + p.input.toFixed(2) + '/M in, $' + p.output.toFixed(2) + '/M out');
  }
  console.log(
    'Cache pricing is an ASSUMPTION, not independently verified: cache write ~' +
      CACHE_WRITE_MULT +
      'x base input price, cache read ~' +
      CACHE_READ_MULT +
      'x base input price.'
  );
  console.log('');

  printUsageTable('Orchestrator usage (main session, by model):', orchestratorUsage);
  console.log('');
  const delegatedCost = printUsageTable('Delegated usage (subagent transcripts, by model):', delegatedUsage);
  console.log('');

  console.log('Subagent dispatches: ' + dispatchCount);
  console.log('  by agent type: ' + (Object.keys(dispatchesByType).length ? JSON.stringify(dispatchesByType) : '(none)'));
  console.log('  by model run : ' + (Object.keys(dispatchesByModel).length ? JSON.stringify(dispatchesByModel) : '(none)'));
  console.log('');

  const ledger = readLedgerEvents(findProjectRoot(cwd));
  if (ledger) {
    printLedgerSection(ledger, dispatchesByModel);
    console.log('');
  }

  const opusPricing = pricingFor('claude-opus-5');
  const delegatedModels = Object.keys(delegatedUsage);
  if (delegatedModels.length === 0) {
    console.log('Estimated saving vs. running delegated work on the expensive (opus) tier: no delegated work recorded yet.');
  } else {
    let hypotheticalOpusCost = 0;
    for (const u of Object.values(delegatedUsage)) {
      if (!opusPricing) continue;
      hypotheticalOpusCost +=
        (u.input_tokens / 1e6) * opusPricing.input +
        (u.output_tokens / 1e6) * opusPricing.output +
        (u.cache_creation_input_tokens / 1e6) * opusPricing.input * CACHE_WRITE_MULT +
        (u.cache_read_input_tokens / 1e6) * opusPricing.input * CACHE_READ_MULT;
    }
    const saving = hypotheticalOpusCost - delegatedCost;
    console.log('Estimated saving vs. running delegated work on the expensive (opus) tier:');
    console.log('  actual delegated cost     : $' + delegatedCost.toFixed(4));
    console.log('  hypothetical cost on opus : $' + hypotheticalOpusCost.toFixed(4) + '  (same measured token counts, re-priced at opus rates)');
    console.log('  estimated saving          : $' + saving.toFixed(4));
    console.log('  ESTIMATE, not a fact: assumes opus would have used the same token volume for the same work.');
    console.log('  Real savings may differ — a bigger model can sometimes solve a task in fewer turns/tokens,');
    console.log('  or a smaller model may need more turns to reach the same result.');
  }
}

if (require.main === module) main();

module.exports = {
  parseOrchestratorDispatches,
  costFor,
  pricingFor,
};
