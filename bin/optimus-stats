#!/usr/bin/env node
'use strict';

/**
 * Implementation behind `/optimus-stats`.
 *
 * Reads Claude Code's own transcript files directly — there is no
 * documented API for this, it's the same mechanism `caveman-stats.js`
 * uses for its own (single-transcript) reporting. Two things this
 * script does that a naive version would get wrong (see README):
 *
 *  1. Subagent usage lives in SEPARATE transcript files
 *     (`<session-dir>/subagents/agent-<id>.jsonl`), not in the parent
 *     session's own transcript. They must be walked explicitly.
 *  2. The convenient rollup Claude Code attaches to the parent's Agent
 *     tool-result (`toolUseResult.usage`) is NOT a reliable total — it
 *     is only the subagent's LAST assistant turn, so it silently
 *     under-counts any subagent that used more than one turn (i.e. used
 *     any tool at all, which is the normal case). This script sums every
 *     `type:"assistant"` line in the actual subagent transcript instead.
 *
 * Degrades to a plain "no data yet" message rather than throwing when
 * there's nothing to report — this must be safe to run in a brand new
 * project with zero history.
 */

const fs = require('fs');
const path = require('path');
const os = require('os');

// Pricing snapshot used during Optimus's research (see README "Known
// limitations" for sourcing). ESTIMATES — verify current numbers at
// https://anthropic.com/pricing before trusting these for anything real.
const PRICING_SNAPSHOT_DATE = '2026-06-24';
const PRICING = {
  'claude-opus-5': { input: 5.0, output: 25.0 },
  'claude-sonnet-5': { input: 2.0, output: 10.0 },
  'claude-haiku-4-5': { input: 1.0, output: 5.0 },
};

// Cache-token multipliers relative to the model's own base input price.
// NOT independently re-verified in this plugin's research — stated
// explicitly as an assumption in the printed output, not silently baked in.
const CACHE_WRITE_MULT = 1.25; // ~5-minute TTL cache write
const CACHE_READ_MULT = 0.1;

function pricingFor(model) {
  if (!model) return null;
  const key = Object.keys(PRICING).find((k) => model.indexOf(k) === 0 || model.indexOf(k) !== -1);
  return key ? PRICING[key] : null;
}

function emptyUsage() {
  return { input_tokens: 0, output_tokens: 0, cache_creation_input_tokens: 0, cache_read_input_tokens: 0, turns: 0 };
}

function addUsage(target, usage) {
  if (!usage) return;
  target.input_tokens += usage.input_tokens || 0;
  target.output_tokens += usage.output_tokens || 0;
  target.cache_creation_input_tokens += usage.cache_creation_input_tokens || 0;
  target.cache_read_input_tokens += usage.cache_read_input_tokens || 0;
  target.turns += 1;
}

function costFor(model, u) {
  const p = pricingFor(model);
  if (!p) return null;
  return (
    (u.input_tokens / 1e6) * p.input +
    (u.output_tokens / 1e6) * p.output +
    (u.cache_creation_input_tokens / 1e6) * p.input * CACHE_WRITE_MULT +
    (u.cache_read_input_tokens / 1e6) * p.input * CACHE_READ_MULT
  );
}

// Empirically observed slug format: cwd with path separators replaced by
// dashes (e.g. /private/tmp/x/y -> -private-tmp-x-y). Undocumented,
// Claude-Code-internal, not a stable public API — if a future version
// changes this layout, this lookup needs updating (see README).
function slugForCwd(cwd) {
  return cwd.replace(/\//g, '-');
}

function readAssistantUsage(filePath, byModel) {
  let raw;
  try {
    raw = fs.readFileSync(filePath, 'utf8');
  } catch (e) {
    return;
  }
  for (const line of raw.split('\n')) {
    const t = line.trim();
    if (!t) continue;
    let rec;
    try {
      rec = JSON.parse(t);
    } catch (e) {
      continue; // skip malformed/half-written lines rather than aborting
    }
    if (rec.type !== 'assistant') continue;
    const msg = rec.message;
    if (!msg || !msg.model) continue;
    if (!byModel[msg.model]) byModel[msg.model] = emptyUsage();
    addUsage(byModel[msg.model], msg.usage);
  }
}

function firstModelIn(filePath) {
  let raw;
  try {
    raw = fs.readFileSync(filePath, 'utf8');
  } catch (e) {
    return null;
  }
  for (const line of raw.split('\n')) {
    const t = line.trim();
    if (!t) continue;
    let rec;
    try {
      rec = JSON.parse(t);
    } catch (e) {
      continue;
    }
    if (rec.type === 'assistant' && rec.message && rec.message.model) return rec.message.model;
  }
  return null;
}

function printUsageTable(title, byModel) {
  console.log(title);
  const models = Object.keys(byModel);
  if (models.length === 0) {
    console.log('  (none)');
    return 0;
  }
  let totalCost = 0;
  for (const model of models) {
    const u = byModel[model];
    const cost = costFor(model, u);
    if (cost !== null) totalCost += cost;
    console.log(
      '  ' +
        model +
        ': turns=' +
        u.turns +
        ' input=' +
        u.input_tokens +
        ' output=' +
        u.output_tokens +
        ' cache_write=' +
        u.cache_creation_input_tokens +
        ' cache_read=' +
        u.cache_read_input_tokens +
        (cost !== null ? ' cost=$' + cost.toFixed(4) : ' cost=unknown (no pricing entry for this model id)')
    );
  }
  console.log('  subtotal cost: $' + totalCost.toFixed(4));
  return totalCost;
}

function main() {
  const cwd = process.env.CLAUDE_PROJECT_DIR || process.cwd();
  const slug = slugForCwd(cwd);
  const projectDir = path.join(os.homedir(), '.claude', 'projects', slug);

  console.log('Optimus stats for ' + cwd);
  console.log('');

  if (!fs.existsSync(projectDir)) {
    console.log('No Optimus usage data yet for this project.');
    console.log(
      '(Looked for ' +
        projectDir +
        " — nothing there yet. This uses Claude Code's undocumented project-slug " +
        'layout [cwd path separators -> dashes]; if a future Claude Code version changes that ' +
        'layout, this lookup will need updating.)'
    );
    process.exit(0);
  }

  let entries = [];
  try {
    entries = fs.readdirSync(projectDir, { withFileTypes: true });
  } catch (e) {
    entries = [];
  }
  const sessionFiles = entries.filter((e) => e.isFile() && e.name.endsWith('.jsonl')).map((e) => e.name);

  if (sessionFiles.length === 0) {
    console.log('No session transcripts found yet for this project.');
    process.exit(0);
  }

  const orchestratorUsage = {};
  const delegatedUsage = {};
  const dispatchesByType = {};
  const dispatchesByModel = {};
  let dispatchCount = 0;

  for (const name of sessionFiles) {
    const sessionId = name.replace(/\.jsonl$/, '');
    readAssistantUsage(path.join(projectDir, name), orchestratorUsage);

    const subagentsDir = path.join(projectDir, sessionId, 'subagents');
    let subFiles = [];
    try {
      subFiles = fs.readdirSync(subagentsDir).filter((f) => f.endsWith('.jsonl'));
    } catch (e) {
      subFiles = [];
    }

    for (const subFile of subFiles) {
      const subPath = path.join(subagentsDir, subFile);
      readAssistantUsage(subPath, delegatedUsage);
      dispatchCount += 1;

      const metaPath = subPath.replace(/\.jsonl$/, '.meta.json');
      let agentType = 'unknown';
      try {
        const meta = JSON.parse(fs.readFileSync(metaPath, 'utf8'));
        if (meta && meta.agentType) agentType = meta.agentType;
      } catch (e) {
        // meta missing or unreadable — still count the dispatch, just as "unknown" type
      }
      dispatchesByType[agentType] = (dispatchesByType[agentType] || 0) + 1;

      const subModel = firstModelIn(subPath);
      if (subModel) dispatchesByModel[subModel] = (dispatchesByModel[subModel] || 0) + 1;
    }
  }

  const totalTurns =
    Object.values(orchestratorUsage).reduce((a, u) => a + u.turns, 0) +
    Object.values(delegatedUsage).reduce((a, u) => a + u.turns, 0);
  if (totalTurns === 0) {
    console.log('No Optimus usage data yet for this project (session files exist but contain no assistant turns).');
    process.exit(0);
  }

  console.log('Project transcript dir: ' + projectDir);
  console.log('');
  console.log('Pricing assumed (USD per million tokens; snapshot dated ' + PRICING_SNAPSHOT_DATE + ' — verify at https://anthropic.com/pricing):');
  for (const [m, p] of Object.entries(PRICING)) {
    console.log('  ' + m + ': $' + p.input.toFixed(2) + '/M in, $' + p.output.toFixed(2) + '/M out');
  }
  console.log(
    'Cache pricing is an ASSUMPTION, not independently verified: cache write ~' +
      CACHE_WRITE_MULT +
      'x base input price, cache read ~' +
      CACHE_READ_MULT +
      'x base input price.'
  );
  console.log('');

  printUsageTable('Orchestrator usage (main session, by model):', orchestratorUsage);
  console.log('');
  const delegatedCost = printUsageTable('Delegated usage (subagent transcripts, by model):', delegatedUsage);
  console.log('');

  console.log('Subagent dispatches: ' + dispatchCount);
  console.log('  by agent type: ' + (Object.keys(dispatchesByType).length ? JSON.stringify(dispatchesByType) : '(none)'));
  console.log('  by model run : ' + (Object.keys(dispatchesByModel).length ? JSON.stringify(dispatchesByModel) : '(none)'));
  console.log('');

  const opusPricing = pricingFor('claude-opus-5');
  const delegatedModels = Object.keys(delegatedUsage);
  if (delegatedModels.length === 0) {
    console.log('Estimated saving vs. running delegated work on the expensive (opus) tier: no delegated work recorded yet.');
  } else {
    let hypotheticalOpusCost = 0;
    for (const u of Object.values(delegatedUsage)) {
      if (!opusPricing) continue;
      hypotheticalOpusCost +=
        (u.input_tokens / 1e6) * opusPricing.input +
        (u.output_tokens / 1e6) * opusPricing.output +
        (u.cache_creation_input_tokens / 1e6) * opusPricing.input * CACHE_WRITE_MULT +
        (u.cache_read_input_tokens / 1e6) * opusPricing.input * CACHE_READ_MULT;
    }
    const saving = hypotheticalOpusCost - delegatedCost;
    console.log('Estimated saving vs. running delegated work on the expensive (opus) tier:');
    console.log('  actual delegated cost     : $' + delegatedCost.toFixed(4));
    console.log('  hypothetical cost on opus : $' + hypotheticalOpusCost.toFixed(4) + '  (same measured token counts, re-priced at opus rates)');
    console.log('  estimated saving          : $' + saving.toFixed(4));
    console.log('  ESTIMATE, not a fact: assumes opus would have used the same token volume for the same work.');
    console.log('  Real savings may differ — a bigger model can sometimes solve a task in fewer turns/tokens,');
    console.log('  or a smaller model may need more turns to reach the same result.');
  }
}

main();
